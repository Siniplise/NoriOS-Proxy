# ── 运行时产物（绝不能进仓库）────────────────────────────────────────────
node_modules/
*.log
battle.log
obs.log
llm_route.log

# 状态文件（每台机器自己生成）
nori_script_state.json
nori_line_seq.json

# 可选数据（游戏/人格侧数据，不随仓库分发；目录里只保留 README）
backend/data/*
!backend/data/README.md

# 录制样本（可能含对话内容）
recordings/

# ── 密钥 / 凭据 ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
_local_key.txt
*_key.txt
*.pem
*.pfx

# ── 项目记忆 / 内部文档 / 备份（不公开）────────────────────────────────
memory/
_arch/
_bak/
_backup/
*.bak
*.before-*
*.backup-*

# ── 编辑器 / 系统 ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
__pycache__/
*.pyc
