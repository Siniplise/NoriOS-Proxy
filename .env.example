# ── 复制成 .env 后按需修改；本文件只有占位值，不含任何真实密钥 ──────────

# 代理监听 / 上游游戏服
NORI_LISTEN=4173
NORI_UPSTREAM=127.0.0.1:4174

# 人格服务（OpenAI 兼容 /v1/*，以及 /act /nori-scriptline 等自有端点）
NORI_LLM_UPSTREAM=127.0.0.1:25503
NORI_LLM_ROUTE=on

# TTS 服务（Inworld 或自建；/tts 整段、/tts.stream 分块 PCM）
NORI_TTS_URL=http://127.0.0.1:8880/tts
NORI_TTS_STREAM_URL=http://127.0.0.1:8880/tts.stream
NORI_TTS_PARALLEL=3
NORI_TTS_GAP_MS=300

# 静态资源根（Nori.Web 发行包的 public 目录；绝对路径）
NORI_ASSET_ROOT=

# 世界包 / 芯片内容（可选功能，留空则该功能关闭）
NORI_PACK_PATH=
NORI_CHIP_PATH=

# 台词去重窗口（毫秒；0 = 关闭）
NORI_LINE_DEDUPE_MS=2500

# 过场闸门（冷开场 / 黑化 / 回忆 / 倒下期间禁止摸头）
NORI_PET_GATE=on

# 新一局时是否重置剧情 beat（台词每局都能说，记忆仍只写第一次）
NORI_RUN_RESET=on
